// Deldo truck-delivery stock file → shared offer contract (pipelines/contracts/normalized-offer.schema.json).
//
// $     = the CSV text pulled from Blob (source "file", contentType text)
// $idm  = { event: {...} } from the trigger stage
//
// COLUMN MAPPING: the headers below are PLACEHOLDERS until Deldo's real test CSV is in
// deldo/. Only this block and the season codes should need to change.
//   EAN ARTICLE BRAND PROFILE WIDTH HEIGHT RIM LOADINDEX SPEEDINDEX SEASON RUNFLAT QTY PRICE
//
// VALIDATION POLICY (row level; the import as a whole never fails on bad rows):
//   rejected: EAN not 8–14 digits · QTY not a non-negative integer · PRICE not a positive
//             decimal (',' or '.') · size fields present but not numeric
//   kept with null: unknown season code, missing optional descriptors
// Why so strict: Elwood's toNumber() returns 0 for garbage and drops thousands/decimal
// separators ("12,5" → 125), so every number is pattern-checked BEFORE conversion.

let rows = $.fromCsv({ delimiter: ";", headers: true })
let seasons = { S: "summer", W: "winter", AS: "all-season", "4S": "all-season" }
let yes = ["Y", "YES", "J", "1", "TRUE", "RF"]

let checked = rows | select r => {
  row: r,
  problems: [
    if r.EAN?.trim().regex("^[0-9]{8,14}$").isEmpty() then "EAN must be 8-14 digits" else null,
    if r.QTY?.trim().regex("^[0-9]+$").isEmpty() then "QTY must be a non-negative integer" else null,
    if r.PRICE?.trim().regex("^[0-9]+([.,][0-9]{1,4})?$").isEmpty() then "PRICE must be a positive decimal" else null,
    if !r.PRICE?.trim().regex("^[0-9]+([.,][0-9]{1,4})?$").isEmpty() && r.PRICE.trim().replace(",", ".").toNumber() <= 0 then "PRICE must be > 0" else null,
    if !r.WIDTH.isNullOrWhiteSpace() && r.WIDTH.trim().regex("^[0-9]{2,3}$").isEmpty() then "WIDTH not numeric" else null,
    if !r.HEIGHT.isNullOrWhiteSpace() && r.HEIGHT.trim().regex("^[0-9]{2,3}$").isEmpty() then "HEIGHT not numeric" else null,
    if !r.RIM.isNullOrWhiteSpace() && r.RIM.trim().regex("^[0-9]{1,2}([.,]5)?$").isEmpty() then "RIM not numeric" else null
  ] | where p => !p.isNull()
}

let rejected = checked
  | where c => !c.problems.isEmpty()
  | select c => { reason: c.problems.concat("; "), row: c.row }

let offers = checked
  | where c => c.problems.isEmpty()
  | select c => c.row
  | select r => {
      ean: r.EAN.trim(),
      supplierCode: r.ARTICLE?.trim(),
      brand: r.BRAND?.trim().toUpper(),
      pattern: r.PROFILE?.trim(),
      width: if r.WIDTH.isNullOrWhiteSpace() then null else r.WIDTH.trim().toNumber(),
      aspect: if r.HEIGHT.isNullOrWhiteSpace() then null else r.HEIGHT.trim().toNumber(),
      rim: if r.RIM.isNullOrWhiteSpace() then null else r.RIM.trim().replace(",", ".").toNumber(),
      loadIndex: r.LOADINDEX?.trim(),
      speedIndex: r.SPEEDINDEX?.trim().toUpper(),
      season: seasons[r.SEASON?.trim().toUpper()],
      runflat: r.RUNFLAT?.trim().toUpper().in(yes),
      quantity: r.QTY.trim().toNumber(),
      price: r.PRICE.trim().replace(",", ".").toNumber(),
      currency: "EUR",
      deliveryMode: "truck"
    }

let ev = $idm.event
return {
  import: {
    supplier: "deldo",
    feed: "truck",
    fileName: ev.fileName,
    blobPath: ev.blobPath,
    etag: ev.etag,
    receivedAt: ev.time,
    receivedDate: ev.time.left(10),
    rowsIn: rows | count,
    rowsOk: offers | count,
    rowsRejected: rejected | count,
    rejected: rejected
  },
  offers: offers
}
