<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Description>Experimental provider-neutral Redis work-item coordination. Not enabled in production hosts.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.*" />
    <ProjectReference Include="../Elwood.Pipeline/Elwood.Pipeline.csproj" />
    <EmbeddedResource Include="WorkItems.lua" />
  </ItemGroup>
</Project>
