{
  "version": "2.0",
  "functionTimeout": "00:05:00",
  "extensions": {
    "http": { "routePrefix": "api" },
    "serviceBus": { "maxConcurrentCalls": 4, "prefetchCount": 0, "maxAutoLockRenewalDuration": "00:05:00", "autoCompleteMessages": true },
    "queues": {
      "batchSize": 4,
      "newBatchThreshold": 2,
      "maxDequeueCount": 5,
      "maxPollingInterval": "00:01:00",
      "visibilityTimeout": "00:01:00",
      "messageEncoding": "base64"
    }
  },
  "logging": {
    "logLevel": { "default": "Warning", "Function": "Information" },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "maxTelemetryItemsPerSecond": 2 },
      "enableLiveMetrics": false
    }
  }
}
